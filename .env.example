# Copy to .env for local development. On Vercel, set the same names under
# Project Settings -> Environment Variables.

# Supabase -> Project Settings -> API (Project URL, and the anon / publishable key).
# The anon key is meant for browser code; row-level security protects the data.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
